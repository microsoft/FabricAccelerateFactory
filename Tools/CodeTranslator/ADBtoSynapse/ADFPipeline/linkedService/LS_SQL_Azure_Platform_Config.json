{
    "name": "LS_SQL_Azure_Platform_Config",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "description": "Platform Config database",
        "annotations": [],
        "type": "AzureSqlDatabase",
        "typeProperties": {
            "connectionString": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=<<sqlServer>>-wus2.database.windows.net;Initial Catalog=<<database>>;User ID=<<user>>",
            "servicePrincipalId": "<<SPN>>",
            "servicePrincipalKey": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "LS_KV_Platform",
                    "type": "LinkedServiceReference"
                },
                "secretName": "<<SecretName>>"
            },
            "tenant": "<<tenantId>>"
        }
    }
}