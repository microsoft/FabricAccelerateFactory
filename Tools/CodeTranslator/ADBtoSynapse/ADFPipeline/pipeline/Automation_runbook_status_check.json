{
    "name": "Automation_runbook_status_check",
    "properties": {
        "activities": [
            {
                "name": "Until",
                "type": "Until",
                "dependsOn": [
                    {
                        "activity": "Automation Runbook Jobid",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@or(equals(activity('Automation Runbook Status').output.properties.status,'Completed' ), equals(activity('Automation Runbook Status').output.properties.status,'Failed'))",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "Automation Runbook Status",
                            "type": "WebActivity",
                            "dependsOn": [
                                {
                                    "activity": "Wait",
                                    "dependencyConditions": [
                                        "Completed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "method": "GET",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "url": {
                                    "value": "@concat(pipeline().parameters.WebUrl, variables('jobid'), '?api-version=2023-11-01')",
                                    "type": "Expression"
                                },
                                "authentication": {
                                    "type": "MSI",
                                    "resource": "https://management.azure.com/"
                                }
                            }
                        },
                        {
                            "name": "Wait",
                            "type": "Wait",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "waitTimeInSeconds": 60
                            }
                        },
                        {
                            "name": "If Condition",
                            "type": "IfCondition",
                            "dependsOn": [
                                {
                                    "activity": "Automation Runbook Status",
                                    "dependencyConditions": [
                                        "Completed"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@equals(activity('Automation Runbook Status').output.properties.status, 'Failed')",
                                    "type": "Expression"
                                },
                                "ifTrueActivities": [
                                    {
                                        "name": "Fail",
                                        "type": "Fail",
                                        "dependsOn": [],
                                        "userProperties": [],
                                        "typeProperties": {
                                            "message": {
                                                "value": "@activity('Automation Runbook Status').output.properties.exception",
                                                "type": "Expression"
                                            },
                                            "errorCode": "400"
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "timeout": "0.12:00:00"
                }
            },
            {
                "name": "Automation Runbook Jobid",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "Calling automation runbook",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "jobid",
                    "value": {
                        "value": "@activity('Calling automation runbook').output.properties.jobid",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Calling automation runbook",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "PUT",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "url": {
                        "value": "@concat(pipeline().parameters.WebUrl, guid(), '?api-version=2023-11-01')",
                        "type": "Expression"
                    },
                    "body": {
                        "value": "@{\n    if(\n        empty(json(pipeline().parameters.BodyParameters)),\n        json(concat('{\"properties\":{\"runbook\":{\"name\":\"', pipeline().parameters.RunbookName, '\"}}}')),\n        json(concat('{\"properties\":{\"runbook\":{\"name\":\"', pipeline().parameters.RunbookName, '\"},\"parameters\":', pipeline().parameters.BodyParameters, '}}'))\n    )\n}",
                        "type": "Expression"
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://management.azure.com/"
                    }
                }
            }
        ],
        "parameters": {
            "RunbookName": {
                "type": "string"
            },
            "BodyParameters": {
                "type": "string"
            },
            "WebUrl": {
                "type": "string"
            }
        },
        "variables": {
            "jobid": {
                "type": "String"
            }
        },
        "folder": {
            "name": "Process Steps/AutomationRunbook"
        },
        "annotations": [],
        "lastPublishTime": "2025-04-02T10:11:58Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}